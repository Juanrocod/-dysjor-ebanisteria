---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Catálogo — DySJor Ebanistería"
  description="Catálogo de muebles estandarizados DySJor. Próximamente."
>
  <Header />
  <main
    class="min-h-screen flex flex-col items-center justify-center text-center px-6 py-32"
    style="background: var(--color-base);"
  >
    <div class="flex items-center gap-3 mb-8">
      <span class="block w-8 h-px" style="background: var(--color-gold);"></span>
      <span class="text-xs tracking-[0.3em] uppercase" style="color: var(--color-gold); font-family: var(--font-sans);">
        Próximamente
      </span>
      <span class="block w-8 h-px" style="background: var(--color-gold);"></span>
    </div>

    <h1
      class="mb-6"
      style="
        font-family: var(--font-serif);
        font-size: clamp(2.5rem, 6vw, 5rem);
        font-weight: 300;
        color: var(--color-text);
        line-height: 1.1;
      "
    >
      Catálogo de<br />
      <em style="color: var(--color-gold); font-style: italic;">muebles estándar.</em>
    </h1>

    <p
      class="max-w-md text-base leading-relaxed mb-10"
      style="color: var(--color-muted); font-family: var(--font-sans); font-weight: 300;"
    >
      Estamos trabajando en una línea de muebles estandarizados de alta calidad. Por ahora, todos nuestros trabajos son a medida.
    </p>

    <a
      href="/"
      class="inline-flex items-center gap-2 text-sm tracking-widest uppercase transition-colors duration-200"
      style="color: var(--color-gold); font-family: var(--font-sans);"
      onmouseover="this.style.color='var(--color-text)'"
      onmouseout="this.style.color='var(--color-gold)'"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
      Volver al inicio
    </a>
  </main>
  <Footer />
</BaseLayout>
