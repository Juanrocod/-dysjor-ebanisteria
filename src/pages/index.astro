---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Trayectoria from '../components/Trayectoria.astro';
import Galeria from '../components/Galeria.astro';
import Materiales from '../components/Materiales.astro';
import Proceso from '../components/Proceso.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---

<BaseLayout>
  <Header />
  <main>
    <Hero />
    <Trayectoria />
    <Galeria />
    <Materiales />
    <Proceso />
    <Contacto />
  </main>
  <Footer />
  <WhatsAppButton />
</BaseLayout>
