---
import { site, navLinks } from '../data/site';

const waHref = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(site.whatsappMensaje)}`;
---

<header id="header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300" style="background: transparent;">
  <div class="max-w-7xl mx-auto px-6 py-5 flex items-center justify-between">

    <!-- Logo / Marca -->
    <a href="#" class="flex flex-col leading-none group">
      <span
        class="text-2xl tracking-[0.2em] uppercase"
        style="font-family: var(--font-serif); color: var(--color-text);"
      >
        DySJor
      </span>
      <span
        class="text-[0.6rem] tracking-[0.35em] uppercase"
        style="color: var(--color-gold);"
      >
        Ebanistería
      </span>
    </a>

    <!-- Nav (desktop) -->
    <nav class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm tracking-widest uppercase transition-colors duration-200"
          style="color: var(--color-muted); font-family: var(--font-sans);"
          onmouseover="this.style.color='var(--color-text)'"
          onmouseout="this.style.color='var(--color-muted)'"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- CTA WhatsApp (desktop) -->
    <a
      href={waHref}
      target="_blank"
      rel="noopener noreferrer"
      class="hidden md:inline-flex items-center gap-2 px-5 py-2.5 text-xs tracking-widest uppercase transition-all duration-200"
      style="border: 1px solid var(--color-gold); color: var(--color-gold); font-family: var(--font-sans);"
      onmouseover="this.style.background='var(--color-gold)'; this.style.color='var(--color-base)';"
      onmouseout="this.style.background='transparent'; this.style.color='var(--color-gold)';"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      WhatsApp
    </a>

    <!-- Menú hamburguesa (mobile) -->
    <button
      id="menu-toggle"
      class="md:hidden flex flex-col gap-1.5 p-1"
      aria-label="Abrir menú"
      style="color: var(--color-text);"
    >
      <span class="block w-6 h-px transition-all" style="background: var(--color-text);"></span>
      <span class="block w-6 h-px transition-all" style="background: var(--color-text);"></span>
      <span class="block w-4 h-px transition-all" style="background: var(--color-gold);"></span>
    </button>
  </div>

  <!-- Nav mobile -->
  <div
    id="mobile-menu"
    class="md:hidden hidden px-6 pb-6 flex-col gap-4"
    style="background: var(--color-surface);"
  >
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="text-sm tracking-widest uppercase py-2"
        style="color: var(--color-muted); border-bottom: 1px solid var(--color-border);"
      >
        {link.label}
      </a>
    ))}
    <a
      href={waHref}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-2 text-center py-3 text-xs tracking-widest uppercase"
      style="border: 1px solid var(--color-gold); color: var(--color-gold);"
    >
      WhatsApp
    </a>
  </div>
</header>

<script>
  // Scroll: fondo oscuro al bajar
  const header = document.getElementById('header')!;
  window.addEventListener('scroll', () => {
    if (window.scrollY > 60) {
      header.style.background = 'rgba(14, 14, 15, 0.95)';
      header.style.backdropFilter = 'blur(12px)';
      header.style.borderBottom = '1px solid rgba(42, 40, 36, 0.6)';
    } else {
      header.style.background = 'transparent';
      header.style.backdropFilter = '';
      header.style.borderBottom = '';
    }
  });

  // Toggle menú mobile
  const toggle = document.getElementById('menu-toggle')!;
  const mobileMenu = document.getElementById('mobile-menu')!;
  toggle.addEventListener('click', () => {
    mobileMenu.classList.toggle('hidden');
    mobileMenu.classList.toggle('flex');
  });

  // Cerrar menú al hacer click en link
  mobileMenu.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      mobileMenu.classList.remove('flex');
    });
  });
</script>
