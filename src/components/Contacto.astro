---
import { site } from '../data/site';

const waHref = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(site.whatsappMensaje)}`;
---

<section
  id="contacto"
  class="py-28 md:py-36"
  style="background: var(--color-surface);"
>
  <div class="max-w-7xl mx-auto px-6">

    <!-- Encabezado -->
    <div class="mb-16">
      <div class="flex items-center gap-3 mb-6">
        <span class="block w-8 h-px" style="background: var(--color-gold);"></span>
        <span class="text-xs tracking-[0.3em] uppercase" style="color: var(--color-gold); font-family: var(--font-sans);">
          Contacto
        </span>
      </div>
      <h2
        class="mb-4"
        style="
          font-family: var(--font-serif);
          font-size: clamp(2rem, 4.5vw, 3.5rem);
          font-weight: 300;
          color: var(--color-text);
          line-height: 1.1;
        "
      >
        ¿Tenés un proyecto<br />
        <em style="color: var(--color-text); font-style: italic;">en mente?</em>
      </h2>
      <p
        style="
          font-family: var(--font-serif);
          font-size: 1.25rem;
          font-style: italic;
          color: var(--color-gold);
          font-weight: 300;
        "
      >
        Contanos tu idea, te escuchamos.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-16 items-start">

      <!-- Columna izquierda: info de contacto -->
      <div class="space-y-8">
        <!-- Datos de contacto -->
        <div class="space-y-6">

          <!-- WhatsApp -->
          <a
            href={waHref}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-5 group"
          >
            <div
              class="w-12 h-12 flex items-center justify-center flex-shrink-0 transition-colors duration-200"
              style="border: 1px solid var(--color-border);"
              onmouseover="this.parentElement.style.color='var(--color-gold)'"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="color: var(--color-gold);">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </div>
            <div>
              <div class="text-xs tracking-widest uppercase mb-1" style="color: var(--color-muted); font-family: var(--font-sans);">WhatsApp</div>
              <div
                class="text-base transition-colors duration-200 group-hover:underline"
                style="color: var(--color-text); font-family: var(--font-sans);"
              >
                {site.telefono}
              </div>
            </div>
          </a>

          <!-- Teléfono -->
          <a
            href={`tel:${site.telefono.replace(/\s/g, '')}`}
            class="flex items-center gap-5 group"
          >
            <div
              class="w-12 h-12 flex items-center justify-center flex-shrink-0"
              style="border: 1px solid var(--color-border);"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--color-gold);">
                <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.69 19.79 19.79 0 01.12 1.1 2 2 0 012.11 0h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.91 7.91a16 16 0 006.16 6.16l1.27-.44a2 2 0 012.11.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
              </svg>
            </div>
            <div>
              <div class="text-xs tracking-widest uppercase mb-1" style="color: var(--color-muted); font-family: var(--font-sans);">Teléfono</div>
              <div
                class="text-base transition-colors duration-200 group-hover:underline"
                style="color: var(--color-text); font-family: var(--font-sans);"
              >
                {site.telefono}
              </div>
            </div>
          </a>

          <!-- Email -->
          <a
            href={`mailto:${site.email}`}
            class="flex items-center gap-5 group"
          >
            <div
              class="w-12 h-12 flex items-center justify-center flex-shrink-0"
              style="border: 1px solid var(--color-border);"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--color-gold);">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
            </div>
            <div>
              <div class="text-xs tracking-widest uppercase mb-1" style="color: var(--color-muted); font-family: var(--font-sans);">Email</div>
              <div
                class="text-base transition-colors duration-200 group-hover:underline"
                style="color: var(--color-text); font-family: var(--font-sans);"
              >
                {site.email}
              </div>
            </div>
          </a>

          <!-- Ubicación -->
          <div class="flex items-center gap-5">
            <div
              class="w-12 h-12 flex items-center justify-center flex-shrink-0"
              style="border: 1px solid var(--color-border);"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--color-gold);">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            <div>
              <div class="text-xs tracking-widest uppercase mb-1" style="color: var(--color-muted); font-family: var(--font-sans);">Ubicación</div>
              <div class="text-base" style="color: var(--color-text); font-family: var(--font-sans);">{site.ubicacion}</div>
            </div>
          </div>

        </div>

        <!-- CTA WhatsApp -->
        <a
          href={waHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 px-8 py-4 text-sm tracking-widest uppercase transition-all duration-300 mt-4"
          style="background: var(--color-gold); color: var(--color-base); font-family: var(--font-sans);"
          onmouseover="this.style.background='var(--color-gold-light)'"
          onmouseout="this.style.background='var(--color-gold)'"
        >
          Escribir por WhatsApp
        </a>

      </div>

      <!-- Columna derecha: formulario -->
      <form
        name="contacto"
        method="POST"
        data-netlify="true"
        class="space-y-6"
      >
        <input type="hidden" name="form-name" value="contacto" />

        <div>
          <label
            for="nombre"
            class="block text-xs tracking-widest uppercase mb-2"
            style="color: var(--color-muted); font-family: var(--font-sans);"
          >
            Nombre *
          </label>
          <input
            type="text"
            id="nombre"
            name="nombre"
            required
            class="w-full px-4 py-3 text-sm outline-none transition-colors duration-200"
            style="
              background: var(--color-surface-2);
              border: 1px solid var(--color-border);
              color: var(--color-text);
              font-family: var(--font-sans);
            "
            onfocus="this.style.borderColor='var(--color-gold)'"
            onblur="this.style.borderColor='var(--color-border)'"
            placeholder="Tu nombre completo"
          />
        </div>

        <div>
          <label
            for="contacto-field"
            class="block text-xs tracking-widest uppercase mb-2"
            style="color: var(--color-muted); font-family: var(--font-sans);"
          >
            Teléfono o email *
          </label>
          <input
            type="text"
            id="contacto-field"
            name="contacto"
            required
            class="w-full px-4 py-3 text-sm outline-none transition-colors duration-200"
            style="
              background: var(--color-surface-2);
              border: 1px solid var(--color-border);
              color: var(--color-text);
              font-family: var(--font-sans);
            "
            onfocus="this.style.borderColor='var(--color-gold)'"
            onblur="this.style.borderColor='var(--color-border)'"
            placeholder="+54 9 11..."
          />
        </div>

        <div>
          <label
            for="mensaje"
            class="block text-xs tracking-widest uppercase mb-2"
            style="color: var(--color-muted); font-family: var(--font-sans);"
          >
            Mensaje *
          </label>
          <textarea
            id="mensaje"
            name="mensaje"
            required
            rows="5"
            class="w-full px-4 py-3 text-sm outline-none transition-colors duration-200 resize-none"
            style="
              background: var(--color-surface-2);
              border: 1px solid var(--color-border);
              color: var(--color-text);
              font-family: var(--font-sans);
            "
            onfocus="this.style.borderColor='var(--color-gold)'"
            onblur="this.style.borderColor='var(--color-border)'"
            placeholder="Contanos tu proyecto: ¿qué mueble buscás, dónde va, medidas aproximadas?"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full py-4 text-sm tracking-widest uppercase transition-all duration-300"
          style="background: transparent; border: 1px solid var(--color-gold); color: var(--color-gold); font-family: var(--font-sans);"
          onmouseover="this.style.background='var(--color-gold)'; this.style.color='var(--color-base)';"
          onmouseout="this.style.background='transparent'; this.style.color='var(--color-gold)';"
        >
          Enviar consulta
        </button>

        <p class="text-xs" style="color: var(--color-muted); font-family: var(--font-sans);">
          * Campos obligatorios. Te respondemos en menos de 24hs.
        </p>
      </form>

    </div>
  </div>
</section>
