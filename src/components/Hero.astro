---
import { site } from '../data/site';

const waHref = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(site.whatsappMensaje)}`;
---

<section
  id="hero"
  class="relative flex items-center justify-center min-h-screen overflow-hidden"
  style="background: var(--color-base);"
>
  <!-- Fondo con textura de madera simulada mediante gradientes -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <!-- Gradiente principal -->
    <div
      class="absolute inset-0"
      style="background: radial-gradient(ellipse 80% 60% at 60% 40%, #1a1208 0%, #0E0E0F 70%);"
    ></div>
    <!-- Líneas verticales sutiles (imitación de veta) -->
    <div
      class="absolute inset-0 opacity-[0.03]"
      style="background-image: repeating-linear-gradient(90deg, #C9A24B 0px, transparent 1px, transparent 80px, #C9A24B 81px);"
    ></div>
    <!-- Overlay inferior -->
    <div
      class="absolute bottom-0 left-0 right-0 h-48"
      style="background: linear-gradient(to top, var(--color-base), transparent);"
    ></div>
  </div>

  <!-- Año decorativo de fondo -->
  <div
    class="absolute right-[-2rem] md:right-8 top-1/2 -translate-y-1/2 select-none pointer-events-none"
    aria-hidden="true"
    style="
      font-family: var(--font-serif);
      font-size: clamp(8rem, 20vw, 18rem);
      font-weight: 300;
      color: transparent;
      -webkit-text-stroke: 1px rgba(201, 162, 75, 0.08);
      line-height: 1;
      letter-spacing: -0.05em;
    "
  >
    1982
  </div>

  <!-- Contenido central -->
  <div class="relative z-10 max-w-5xl mx-auto px-6 text-center md:text-left">

    <!-- Pill / eyebrow -->
    <div class="inline-flex items-center gap-3 mb-16 md:mb-8">
      <span class="block w-8 h-px" style="background: var(--color-gold);"></span>
      <span
        class="text-xs tracking-[0.3em] uppercase"
        style="color: var(--color-gold); font-family: var(--font-sans);"
      >
        Ebanistería de alta gama · Desde 1982
      </span>
    </div>

    <!-- Título principal -->
    <h1
      class="mb-6"
      style="
        font-family: var(--font-serif);
        font-size: clamp(2.8rem, 7vw, 6rem);
        font-weight: 300;
        color: var(--color-text);
        line-height: 1.05;
        letter-spacing: -0.01em;
      "
    >
      Si lo podés<br />
      <em style="color: var(--color-gold); font-style: italic;">imaginar,</em><br />
      lo podemos crear.
    </h1>

    <!-- Subtítulo -->
    <p
      class="max-w-xl mb-10 text-lg leading-relaxed md:mx-0 mx-auto"
      style="color: var(--color-muted); font-family: var(--font-sans); font-weight: 300;"
    >
      Fabricando hogares a medida desde 1982, Buenos Aires, Argentina.
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
      <a
        href={waHref}
        target="_blank"
        rel="noopener noreferrer"
        class="wa-btn inline-flex items-center justify-center gap-3 px-8 py-4 text-sm tracking-widest uppercase font-medium transition-all duration-300"
        style="background: var(--color-gold); color: var(--color-base); font-family: var(--font-sans);"
        onmouseover="this.style.background='var(--color-gold-light)'"
        onmouseout="this.style.background='var(--color-gold)'"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Hablemos
      </a>

      <a
        href="#trabajos"
        class="inline-flex items-center justify-center gap-3 px-8 py-4 text-sm tracking-widest uppercase transition-all duration-300"
        style="border: 1px solid rgba(201,162,75,0.4); color: var(--color-text); font-family: var(--font-sans);"
        onmouseover="this.style.borderColor='var(--color-gold)'; this.style.color='var(--color-gold)';"
        onmouseout="this.style.borderColor='rgba(201,162,75,0.4)'; this.style.color='var(--color-text)';"
      >
        Ver trabajos
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M19 9l-7 7-7-7"/>
        </svg>
      </a>
    </div>

    <!-- Stats -->
    <div class="mt-16 flex flex-wrap gap-10 justify-center md:justify-start">
      {[
        { num: '+44', label: 'Años de oficio' },
        { num: '100%', label: 'A medida' },
        { num: '∞', label: 'Materiales premium' },
      ].map(stat => (
        <div class="text-center md:text-left">
          <div
            style="font-family: var(--font-serif); font-size: 2rem; font-weight: 300; color: var(--color-gold);"
          >
            {stat.num}
          </div>
          <div
            class="text-xs tracking-widest uppercase mt-1"
            style="color: var(--color-muted);"
          >
            {stat.label}
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 animate-bounce">
    <span class="text-xs tracking-widest uppercase" style="color: var(--color-muted);">Scroll</span>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--color-gold);">
      <path d="M19 9l-7 7-7-7"/>
    </svg>
  </div>
</section>
