---
import { trabajos } from '../data/trabajos';
---

<section
  id="trabajos"
  class="py-28 md:py-36"
  style="background: var(--color-base);"
>
  <div class="max-w-7xl mx-auto px-6">

    <!-- Encabezado -->
    <div class="flex flex-col md:flex-row md:items-end md:justify-between mb-16 gap-6">
      <div>
        <div class="flex items-center gap-3 mb-6">
          <span class="block w-8 h-px" style="background: var(--color-gold);"></span>
          <span class="text-xs tracking-[0.3em] uppercase" style="color: var(--color-gold); font-family: var(--font-sans);">
            Portfolio
          </span>
        </div>
        <h2
          style="
            font-family: var(--font-serif);
            font-size: clamp(2rem, 4.5vw, 3.5rem);
            font-weight: 300;
            color: var(--color-text);
            line-height: 1.1;
          "
        >
          Algunos de<br />nuestros trabajos.
        </h2>
      </div>
      <p
        class="max-w-xs text-sm leading-relaxed"
        style="color: var(--color-muted); font-family: var(--font-sans); font-weight: 300;"
      >
        Cada pieza es única. Estos son algunos ejemplos — podés ver más en la consulta inicial.
      </p>
    </div>

    <!-- Grilla -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px" style="background: var(--color-border);">
      {trabajos.map((trabajo) => (
        <button
          class="gallery-item group relative overflow-hidden aspect-[4/3] text-left cursor-pointer"
          style={`background: var(--color-surface);`}
          data-id={trabajo.id}
          aria-label={`Ver ${trabajo.titulo}`}
        >
          <!-- Imagen thumbnail -->
          <img
            src={trabajo.imagenes[0]}
            alt={trabajo.titulo}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
          />

          <!-- Indicador de fotos múltiples -->
          {trabajo.imagenes.length > 1 && (
            <div
              class="absolute top-4 left-4 flex items-center gap-1 px-2 py-0.5 text-[0.6rem] tracking-widest uppercase"
              style="background: rgba(14,14,15,0.7); color: var(--color-gold); font-family: var(--font-sans); backdrop-filter: blur(4px);"
            >
              <svg width="10" height="10" viewBox="0 0 10 10" fill="none" style="flex-shrink:0;">
                <rect x="0.5" y="2.5" width="6" height="6" rx="0.5" stroke="currentColor" stroke-width="0.8"/>
                <rect x="2.5" y="0.5" width="6" height="6" rx="0.5" stroke="currentColor" stroke-width="0.8" fill="rgba(14,14,15,0.7)"/>
              </svg>
              {trabajo.imagenes.length}
            </div>
          )}

          <!-- Hover overlay -->
          <div
            class="absolute inset-0 flex flex-col justify-end p-6 opacity-0 group-hover:opacity-100 transition-all duration-500"
            style="background: linear-gradient(to top, rgba(14,14,15,0.95) 0%, rgba(14,14,15,0.4) 60%, transparent 100%);"
          >
            <div class="translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
              <div class="flex flex-wrap gap-1.5 mb-3">
                {trabajo.materiales.map(mat => (
                  <span
                    class="text-[0.6rem] tracking-widest uppercase px-2 py-0.5"
                    style="border: 1px solid rgba(201,162,75,0.5); color: var(--color-gold); font-family: var(--font-sans);"
                  >
                    {mat}
                  </span>
                ))}
              </div>
              <h3
                class="text-lg leading-tight mb-1"
                style="font-family: var(--font-serif); font-weight: 400; color: var(--color-text);"
              >
                {trabajo.titulo}
              </h3>
              <p class="text-xs" style="color: var(--color-muted); font-family: var(--font-sans);">
                Toca para ver detalles
              </p>
            </div>
          </div>

          <!-- Número -->
          <div
            class="absolute top-4 right-4 text-xs tracking-widest"
            style="color: rgba(201,162,75,0.4); font-family: var(--font-sans);"
          >
            0{trabajo.id}
          </div>
        </button>
      ))}
    </div>

  </div>
</section>

<!-- Lightbox -->
<div
  id="lightbox"
  class="fixed inset-0 z-50 hidden items-center justify-center p-6"
  style="background: rgba(14,14,15,0.96); backdrop-filter: blur(12px);"
  role="dialog"
  aria-modal="true"
>
  <button
    id="lightbox-close"
    class="absolute top-6 right-6 text-xs tracking-widest uppercase flex items-center gap-2 transition-colors duration-200"
    style="color: var(--color-muted);"
    onmouseover="this.style.color='var(--color-text)'"
    onmouseout="this.style.color='var(--color-muted)'"
  >
    <span>Cerrar</span>
    <span style="font-size: 1.2rem; line-height: 1;">✕</span>
  </button>

  <div class="max-w-2xl w-full">
    <!-- Imagen con navegación -->
    <div class="relative mb-8">
      <img
        id="lightbox-img"
        src=""
        alt=""
        class="block mx-auto max-w-full max-h-[72vh] object-contain"
      />

      <!-- Flecha anterior -->
      <button
        id="lightbox-prev"
        class="hidden absolute left-3 top-1/2 -translate-y-1/2 w-9 h-9 flex items-center justify-center transition-colors duration-200"
        style="background: rgba(14,14,15,0.7); color: var(--color-text); backdrop-filter: blur(4px);"
        aria-label="Imagen anterior"
      >&#8249;</button>

      <!-- Flecha siguiente -->
      <button
        id="lightbox-next"
        class="hidden absolute right-3 top-1/2 -translate-y-1/2 w-9 h-9 flex items-center justify-center transition-colors duration-200"
        style="background: rgba(14,14,15,0.7); color: var(--color-text); backdrop-filter: blur(4px);"
        aria-label="Imagen siguiente"
      >&#8250;</button>

      <!-- Contador de imágenes -->
      <div
        id="lightbox-counter"
        class="hidden absolute bottom-3 right-3 text-[0.6rem] tracking-widest px-2 py-0.5"
        style="background: rgba(14,14,15,0.7); color: var(--color-muted); font-family: var(--font-sans); backdrop-filter: blur(4px);"
      ></div>
    </div>

    <div id="lightbox-tags" class="flex flex-wrap gap-2 mb-4"></div>

    <h3
      id="lightbox-title"
      class="mb-3"
      style="font-family: var(--font-serif); font-size: 2rem; font-weight: 300; color: var(--color-text);"
    ></h3>

    <p
      id="lightbox-desc"
      style="color: var(--color-muted); font-family: var(--font-sans); font-weight: 300; line-height: 1.7;"
    ></p>
  </div>
</div>

<script define:vars={{ trabajos }}>
  const lb = document.getElementById('lightbox');
  const lbClose = document.getElementById('lightbox-close');
  const lbImg = document.getElementById('lightbox-img');
  const lbTitle = document.getElementById('lightbox-title');
  const lbDesc = document.getElementById('lightbox-desc');
  const lbTags = document.getElementById('lightbox-tags');
  const lbPrev = document.getElementById('lightbox-prev');
  const lbNext = document.getElementById('lightbox-next');
  const lbCounter = document.getElementById('lightbox-counter');

  let activeTrabajo = null;
  let activeIndex = 0;

  function renderImage() {
    const t = activeTrabajo;
    const multi = t.imagenes.length > 1;

    lbImg.src = t.imagenes[activeIndex];
    lbImg.alt = t.titulo;

    if (multi) {
      lbPrev.classList.remove('hidden');
      lbNext.classList.remove('hidden');
      lbCounter.classList.remove('hidden');
      lbCounter.textContent = `${activeIndex + 1} / ${t.imagenes.length}`;
      lbPrev.style.opacity = activeIndex === 0 ? '0.3' : '1';
      lbNext.style.opacity = activeIndex === t.imagenes.length - 1 ? '0.3' : '1';
    } else {
      lbPrev.classList.add('hidden');
      lbNext.classList.add('hidden');
      lbCounter.classList.add('hidden');
    }
  }

  function openLightbox(id) {
    activeTrabajo = trabajos.find(t => t.id === id);
    if (!activeTrabajo) return;
    activeIndex = 0;

    lbTitle.textContent = activeTrabajo.titulo;
    lbDesc.textContent = activeTrabajo.descripcion;
    lbTags.innerHTML = activeTrabajo.materiales
      .map(m => `<span style="border:1px solid rgba(201,162,75,0.5);color:var(--color-gold);font-family:var(--font-sans);font-size:0.65rem;letter-spacing:0.15em;text-transform:uppercase;padding:0.2rem 0.5rem;">${m}</span>`)
      .join('');

    renderImage();
    lb.classList.remove('hidden');
    lb.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    lb.classList.add('hidden');
    lb.classList.remove('flex');
    document.body.style.overflow = '';
    activeTrabajo = null;
  }

  function prevImage() {
    if (!activeTrabajo || activeIndex === 0) return;
    activeIndex--;
    renderImage();
  }

  function nextImage() {
    if (!activeTrabajo || activeIndex === activeTrabajo.imagenes.length - 1) return;
    activeIndex++;
    renderImage();
  }

  document.querySelectorAll('.gallery-item').forEach(btn => {
    btn.addEventListener('click', () => openLightbox(Number(btn.dataset.id)));
  });

  lbPrev.addEventListener('click', (e) => { e.stopPropagation(); prevImage(); });
  lbNext.addEventListener('click', (e) => { e.stopPropagation(); nextImage(); });
  lbClose.addEventListener('click', closeLightbox);
  lb.addEventListener('click', (e) => { if (e.target === lb) closeLightbox(); });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') prevImage();
    if (e.key === 'ArrowRight') nextImage();
  });
</script>
