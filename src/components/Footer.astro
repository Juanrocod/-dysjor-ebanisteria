---
import { site, navLinks } from '../data/site';

const year = new Date().getFullYear();
---

<footer
  class="py-16"
  style="background: var(--color-base); border-top: 1px solid var(--color-border);"
>
  <div class="max-w-7xl mx-auto px-6">

    <!-- Top row -->
    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-10 mb-12">

      <!-- Marca -->
      <div class="max-w-xs">
        <div
          class="text-3xl mb-1 tracking-[0.15em] uppercase"
          style="font-family: var(--font-serif); color: var(--color-text);"
        >
          DySJor
        </div>
        <div
          class="text-xs tracking-[0.35em] uppercase mb-4"
          style="color: var(--color-gold); font-family: var(--font-sans);"
        >
          Ebanistería
        </div>
        <p
          class="text-sm leading-relaxed"
          style="color: var(--color-muted); font-family: var(--font-sans); font-weight: 300;"
        >
          Fabricando hogares a medida desde {site.fundacion}.<br />
          {site.ubicacion}.
        </p>
      </div>

      <!-- Nav -->
      <nav class="flex flex-col gap-3">
        <div class="text-xs tracking-widest uppercase mb-2" style="color: var(--color-muted); font-family: var(--font-sans);">
          Secciones
        </div>
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm transition-colors duration-200"
            style="color: var(--color-muted); font-family: var(--font-sans);"
            onmouseover="this.style.color='var(--color-gold)'"
            onmouseout="this.style.color='var(--color-muted)'"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Próximamente: Catálogo -->
      <div>
        <div class="text-xs tracking-widest uppercase mb-2" style="color: var(--color-muted); font-family: var(--font-sans);">
          Próximamente
        </div>
        <div
          class="inline-flex items-center gap-2 px-4 py-2 text-xs tracking-widest uppercase"
          style="border: 1px solid rgba(201,162,75,0.2); color: rgba(201,162,75,0.5); font-family: var(--font-sans);"
        >
          <span class="block w-1.5 h-1.5 rounded-full animate-pulse" style="background: var(--color-gold); opacity: 0.5;"></span>
          Catálogo de muebles
        </div>
        <p
          class="mt-3 text-xs leading-relaxed max-w-[16rem]"
          style="color: var(--color-muted); font-family: var(--font-sans); font-weight: 300; opacity: 0.7;"
        >
          Línea de muebles estandarizados. Muy pronto.
        </p>
      </div>

    </div>

    <!-- Divider -->
    <div class="h-px mb-8" style="background: var(--color-border);"></div>

    <!-- Bottom row -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <p
        class="text-xs"
        style="color: var(--color-muted); font-family: var(--font-sans); opacity: 0.6;"
      >
        © {year} DySJor — Todos los derechos reservados.
      </p>
      <p
        class="text-xs"
        style="color: var(--color-muted); font-family: var(--font-sans); opacity: 0.4;"
      >
        Ebanistería de alta gama · Muebles a medida
      </p>
    </div>

  </div>
</footer>
